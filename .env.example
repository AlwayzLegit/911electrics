# Database connection string
DATABASE_URL=mongodb://127.0.0.1/your-database-name

# Or use a PG connection string
#DATABASE_URL=postgresql://127.0.0.1:5432/your-database-name

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# Lead notification email (Resend) — REQUIRED in production, otherwise no
# email is sent when a lead arrives (the lead is still saved to the database).
# The from-address domain must be verified in your Resend account.
RESEND_API_KEY=YOUR_RESEND_API_KEY
LEAD_NOTIFICATION_EMAIL=owner@example.com
LEAD_FROM_EMAIL=leads@example.com

# Optional Cloudflare Turnstile spam protection on the lead forms
#TURNSTILE_SECRET_KEY=

# Sentry error & performance monitoring.
# The DSN is public (safe to commit) and already baked into the app as a
# fallback, so monitoring works out of the box. Override per-environment here
# if you ever rotate it.
#NEXT_PUBLIC_SENTRY_DSN=https://61e39fc530a4d81203261c3d31592b9a@o4511575678517249.ingest.us.sentry.io/4511575758405632
# SECRET — required only to upload source maps during the Vercel build so
# stack traces are de-minified. Create at:
# https://911electrics.sentry.io/settings/auth-tokens/ (scope: project:releases).
# Add it as a Vercel Production env var; builds still succeed without it.
#SENTRY_AUTH_TOKEN=YOUR_SENTRY_AUTH_TOKEN

# Google reviews sync (admin "Sync Google Reviews" button + weekly cron).
# Create a Google Cloud API key with "Places API (New)" enabled.
GOOGLE_PLACES_API_KEY=YOUR_GOOGLE_PLACES_API_KEY
# Defaults to the 911 Construction & Electric business if unset
#GOOGLE_PLACE_ID=ChIJF6lnmlDDwoARebR7r9k_oG0
